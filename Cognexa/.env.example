# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME="INDUS MIND API"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=production
LOG_LEVEL=INFO

# ─── Database ─────────────────────────────────────────────────────────────────
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://indusmind:indusmind@postgres:5432/indusmind

# ─── Security ─────────────────────────────────────────────────────────────────
# IMPORTANT: Generate a strong secret key for production
# Run: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_AT_LEAST_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Weaviate ─────────────────────────────────────────────────────────────────
WEAVIATE_URL=http://weaviate:8080
# WEAVIATE_API_KEY=your_weaviate_api_key  # Uncomment if Weaviate auth is enabled

# ─── MinIO (Object Storage) ───────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=indusmind-documents
MINIO_SECURE=false

# ─── LLM (OpenAI-compatible) ──────────────────────────────────────────────────
# Use OpenAI, Azure OpenAI, Ollama, LM Studio, or any compatible endpoint
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# For local Ollama: OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# For Azure OpenAI: OPENAI_BASE_URL=https://your-resource.openai.azure.com/openai/deployments/your-deployment

# ─── Embedding ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ─── Chunking ─────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ─── OCR ──────────────────────────────────────────────────────────────────────
# Set USE_TEXTRACT=true to use AWS Textract instead of Tesseract
USE_TEXTRACT=false
# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret
# AWS_REGION=us-east-1

# ─── CORS ─────────────────────────────────────────────────────────────────────
# JSON list of allowed origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Phase 2: Redis / Celery ────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=50
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_SOFT_TIME_LIMIT=600
CELERY_TASK_TIME_LIMIT=900
TEMP_FILE_MAX_AGE_HOURS=24
FAILED_JOB_RETENTION_DAYS=30
